# Copie este arquivo para ".env" (na pasta backend) e preencha com a sua string do MongoDB Atlas.
# O arquivo .env NÃO deve ser enviado ao GitHub.
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/pokedex?retryWrites=true&w=majority

# Administrador criado na primeira execução (opcional). Sem ADMIN_PASSWORD, só existem contas
# cadastradas pela tela "Cadastrar" / POST /api/auth/register.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo que assina os tokens JWT (mínimo 32 caracteres). Gere um valor aleatório, por exemplo no PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
# Validade do token em minutos (opcional, padrão 120)
JWT_EXPIRATION_MINUTES=120
